{
  "swagger": "2.0",
  "info": {"title": "Masterblog API", "version": "1.0.0"},
  "tags": [{"name": "Post", "description": "Post API - CRUD"}],
  "definitions": {
    "Post": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "title": {"type": "string"},
        "content": {"type": "string"},
        "author": {"type": "string"},
        "date": {"type": "string", "example": "2023-06-07"}
      }
    },
    "NewPost": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": {"type": "string"},
        "content": {"type": "string"},
        "author": {"type": "string"},
        "date": {"type": "string", "example": "2023-06-07"}
      }
    }
  },
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Returns all posts (optionally sorted)",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {"name": "sort", "in": "query", "type": "string",
           "enum": ["title", "content", "author", "date"]},
          {"name": "direction", "in": "query", "type": "string",
           "enum": ["asc", "desc"]}
        ],
        "responses": {
          "200": {"description": "Successful operation",
                  "schema": {"type": "array", "items": {"$ref": "#/definitions/Post"}}},
          "400": {"description": "Invalid sort field or direction"}
        }
      },
      "post": {
        "summary": "Add a new post",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {"name": "body", "in": "body", "required": true,
           "schema": {"$ref": "#/definitions/NewPost"}}
        ],
        "responses": {
          "201": {"description": "Post created",
                  "schema": {"$ref": "#/definitions/Post"}},
          "400": {"description": "Missing title/content or invalid date"}
        }
      }
    },
    "/api/posts/{id}": {
      "delete": {
        "summary": "Delete a post by id",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "type": "integer"}
        ],
        "responses": {
          "200": {"description": "Post deleted"},
          "404": {"description": "Post not found"}
        }
      },
      "put": {
        "summary": "Update a post by id",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "type": "integer"},
          {"name": "body", "in": "body",
           "schema": {"$ref": "#/definitions/NewPost"}}
        ],
        "responses": {
          "200": {"description": "Post updated",
                  "schema": {"$ref": "#/definitions/Post"}},
          "400": {"description": "Invalid date"},
          "404": {"description": "Post not found"}
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Search posts by title, content, author or date",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {"name": "title", "in": "query", "type": "string"},
          {"name": "content", "in": "query", "type": "string"},
          {"name": "author", "in": "query", "type": "string"},
          {"name": "date", "in": "query", "type": "string"}
        ],
        "responses": {
          "200": {"description": "List of matching posts (may be empty)",
                  "schema": {"type": "array", "items": {"$ref": "#/definitions/Post"}}}
        }
      }
    }
  }
}